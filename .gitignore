# ---------------------------------------------------------------------------
#  Anchorage — repository ignore rules
# ---------------------------------------------------------------------------

# --- Android / Gradle ------------------------------------------------------
android/.gradle/
android/build/
android/*/build/
android/*/*/build/
android/local.properties
android/.idea/
android/captures/
android/.cxx/
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class
*.jks
*.keystore

# --- Flutter / Dart --------------------------------------------------------
flutter/.dart_tool/
flutter/.flutter-plugins
flutter/.flutter-plugins-dependencies
flutter/.packages
flutter/build/
flutter/android/.gradle/
flutter/android/local.properties
flutter/android/app/debug/
flutter/android/app/profile/
flutter/android/app/release/
flutter/ios/Pods/
flutter/ios/.symlinks/
flutter/ios/Flutter/Flutter.framework
flutter/ios/Flutter/Flutter.podspec
flutter/ios/Flutter/Generated.xcconfig
flutter/ios/Flutter/flutter_export_environment.sh
flutter/ios/Runner.xcworkspace/xcshareddata/
flutter/coverage/

# `pubspec.lock` IS committed: this is an application, not a library, and a
# reproducible dependency set is the point.

# --- IDE -------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/settings.json

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Logs / temp -----------------------------------------------------------
*.log
*.tmp
*.hprof

# --- Markdown --------------------------------------------------------------
# Every Markdown file is ignored except README.md, which stays as the one
# document the repository presents to a reader.
#
# The negation must come *after* the `*.md` pattern — git applies the last
# matching rule, so reversing these two lines would silently ignore README.md
# along with everything else.
#
# `!README.md` (no leading slash) keeps a file of that name at *any* depth:
# the root README, `docs/screenshots/README.md`, and the Flutter-generated
# `flutter/ios/.../LaunchImage.imageset/README.md`. To keep only the one at the
# repository root, change it to `!/README.md`.
*.md
!README.md
