<?xml version="1.0" encoding="utf-8"?>
<!--
  The stock Android Studio launcher icon: the green robot on its patterned
  green field, exactly as a freshly created project ships. Deliberate, not an
  oversight - neither app in this repository carries branding of its own.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
